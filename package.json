{
  "name": "motion-studio-7",
  "version": "7.4.0",
  "description": "Motion graphics 2D con HyperFrames como motor principal y Remotion alternativo",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/player": "4.0.539",
    "hyperframes": "0.8.225",
    "puppeteer-core": "25.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "studio:build": "vite build",
    "studio:start": "node server.mjs",
    "studio:dev": "vite",
    "test": "node --test plugin-package.test.mjs brand-profile.test.mjs reference-parity-gate.test.mjs pacing-quality-audit.test.mjs loop-quality-audit.test.mjs sound-design.test.mjs style-catalog.test.mjs acceptance-five-topics.test.mjs contact-motion-audit.test.mjs audio-quality-audit.test.mjs quality-contact-sheet.test.mjs direction-compiler.test.mjs render-quality-audit.test.mjs visual-iteration-video.test.mjs visual-autonomous.test.mjs visual-direction-audit.test.mjs visual-action-planner.test.mjs canvas-3d-engine.test.mjs server-utils.test.mjs cloud-integrations.test.mjs auto-graphics.test.mjs ai-planner.test.mjs semantic-director.test.mjs media-director.test.mjs hyperframes-bridge.test.mjs hyperframes-v7.test.mjs hyperframes-server.test.mjs windows-launcher.test.mjs windows-media-path.test.mjs custom-scene.test.mjs custom-scene-preflight.test.mjs export-regressions.test.mjs explainer.test.mjs motion-ecosystem.test.mjs windows-native-runtime.test.mjs plugins/motion-graphics/skills/motion-graphics/tests/*.test.mjs render-lifecycle.test.mjs hyperframes-progress.test.mjs caption-pixels.test.mjs",
    "test:ai-route": "node --test ai-route.test.mjs",
    "test:p2": "node --test broll-contract.test.mjs",
    "accept:broll:alpha": "node scripts/acceptance-broll-alpha.mjs",
    "accept:styles:21": "node scripts/acceptance-21-styles.mjs",
    "test:p3": "node --test style-recipes-p3.test.mjs",
    "test:p4": "node --test specialized-workflows-p4.test.mjs",
    "accept:workflows:p4": "node scripts/acceptance-specialized-p4.mjs",
    "test:p5": "node --test character-motion-p5.test.mjs",
    "test:p6": "node --test audio-simulation-p6.test.mjs",
    "test:p7": "node --test external-adapters-p7.test.mjs",
    "test:p8": "node --test final-homologation-p8.test.mjs",
    "test:p81": "node --test authoring-workflows-p81.test.mjs",
    "test:p82": "node --test loop-quality-audit.test.mjs pacing-quality-audit.test.mjs",
    "test:p83": "node --test reference-alignment-p83.test.mjs",
    "test:p8:final": "node --test reference-revision-gate-p8.test.mjs visual-autonomous.test.mjs",
    "homologation:p8": "node scripts/final-homologation-p8.mjs",
    "homologation:p8:ci": "node scripts/final-homologation-p8.mjs --evidence out/p8-evidence --out out/p8-final --require-video-artifacts",
    "homologation:p8:strict": "node scripts/final-homologation-p8.mjs --strict",
    "accept:audio-simulations:p6": "node scripts/acceptance-audio-simulations-p6.mjs",
    "accept:characters:p5": "node scripts/acceptance-characters-p5.mjs",
    "test:audio-cues": "node scripts/verify-audio-cues.mjs",
    "test:smoke": "node scripts/smoke-v2.mjs",
    "test:acceptance-v71": "node scripts/acceptance-v71.mjs",
    "render:motion-test": "remotion render StudioVideo out/motion-studio-v4-test.mp4 --props=scripts/smoke-v31-props.json --codec=h264 --concurrency=1 --hardware-acceleration=disable",
    "check:system": "node scripts/check-system.mjs",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "test:explainer": "node --test explainer.test.mjs",
    "review:explainer": "node scripts/review-explainer.mjs",
    "review:offline": "node scripts/review-explainer-offline.mjs",
    "test:ecosystem": "node scripts/check-motion-ecosystem.mjs",
    "plugin:check": "node scripts/check-plugin-package.mjs",
    "accept:five": "node scripts/acceptance-five-topics.mjs",
    "accept:five:runtime": "node scripts/acceptance-five-topics.mjs --runtime",
    "accept:five:render": "node scripts/acceptance-five-topics.mjs --render",
    "integration:status": "node scripts/reference-parity-gate.mjs",
    "integration:gate": "node scripts/reference-parity-gate.mjs --strict"
  }
}
