{
  "name": "motion-studio-7",
  "version": "7.1.3",
  "description": "Motion graphics 2D con HyperFrames como motor principal y Remotion alternativo",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/player": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "studio:build": "vite build",
    "studio:start": "node server.mjs",
    "studio:dev": "vite",
    "test": "node --test visual-action-planner.test.mjs canvas-3d-engine.test.mjs server-utils.test.mjs cloud-integrations.test.mjs auto-graphics.test.mjs ai-planner.test.mjs semantic-director.test.mjs media-director.test.mjs hyperframes-bridge.test.mjs hyperframes-v7.test.mjs hyperframes-server.test.mjs windows-launcher.test.mjs windows-media-path.test.mjs custom-scene.test.mjs export-regressions.test.mjs",
    "test:ai-route": "node --test ai-route.test.mjs",
    "test:audio-cues": "node scripts/verify-audio-cues.mjs",
    "test:smoke": "node scripts/smoke-v2.mjs",
    "test:acceptance-v71": "node scripts/acceptance-v71.mjs",
    "render:motion-test": "remotion render StudioVideo out/motion-studio-v4-test.mp4 --props=scripts/smoke-v31-props.json --codec=h264 --concurrency=1 --hardware-acceleration=disable",
    "check:system": "node scripts/check-system.mjs",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  }
}
