# Copia este archivo como .env junto a server.mjs.
# Deja los campos vacíos si no utilizas la API. No compartas .env.
PIXABAY_API_KEY=
GROQ_API_KEY=

# Opcional: router FreeLLMAPI ejecutándose en este equipo o en un servidor HTTPS.
# No compartas el token. Se envían únicamente textos cuando pulsas el botón de IA.
# FreeLLMAPI Desktop en Windows utiliza normalmente el puerto que aparece en
# Claves > Clave de API unificada (en tu captura: 31415). Cambia si es distinto.
FREELLMAPI_BASE_URL=http://127.0.0.1:31415
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
